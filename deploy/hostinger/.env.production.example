# Domínio público do sistema, sem https://
BIPAGEM_DOMAIN=bipagem.seudominio.com.br
CADDY_EMAIL=seu-email@seudominio.com.br

# Supabase: os dois primeiros valores são públicos e entram no build do Next.js.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=SUA_CHAVE_PUBLICAVEL

# Segredos usados somente no servidor.
SUPABASE_SERVICE_ROLE_KEY=SUA_CHAVE_SERVICE_ROLE
RESEND_API_KEY=SUA_CHAVE_RESEND
RELATORIOS_EMAIL_FROM=Sistema Despacho <despacho@seudominio.com.br>
RELATORIOS_EMAIL_REPLY_TO=
FEEDBACK_EMAIL_TO=jefersondr10@gmail.com

# Deve permanecer desligado em produção.
ENABLE_MOBILE_BIPAGEM_DEMO=0
